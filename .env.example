# Salin file ini jadi .env lalu isi nilainya:
#   cp .env.example .env
# Setelah mengubah .env, restart dev server (npm run dev).

# URL backend API (contoh: http://localhost:8000/api)
VITE_API_URL=

# Google OAuth Client ID untuk "Lanjut dengan Google"
# (contoh: xxxxxxxxxxxx-xxxxxxxx.apps.googleusercontent.com)
VITE_GOOGLE_CLIENT_ID=
